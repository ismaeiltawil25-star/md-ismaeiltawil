// Windows version resource, generated by CMake from version.rc.in.
// Product name and version are required by code-signing policies (SignPath
// checks them on every signed file) and are shown in Explorer > Properties.
// Edit the version only in the top-level CMakeLists.txt (project VERSION).

#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Ismaeil Tawil"
            VALUE "FileDescription",  "MD Backpack Reader - Markdown and PDF reader"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "md-backpack-reader"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Ismaeil Tawil. MIT License."
            VALUE "OriginalFilename", "md-backpack-reader.exe"
            VALUE "ProductName",      "MD Backpack Reader"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
